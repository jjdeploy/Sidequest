{
  "name": "bearings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real browsers, placed at your coordinates, reading every local listing at once. Get your bearings in a town you don't know yet.",
  "scripts": {
    "plan": "tsx --env-file-if-exists=.env src/cli.ts plan",
    "dashboard": "tsx --env-file-if-exists=.env src/web/server.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sources": "tsx --env-file-if-exists=.env src/cli.ts sources",
    "feedback": "tsx --env-file-if-exists=.env src/cli.ts feedback",
    "history": "tsx --env-file-if-exists=.env src/cli.ts history",
    "geo-proof": "tsx --env-file-if-exists=.env src/geo-proof.ts",
    "harden": "tsx --env-file-if-exists=.env src/harden.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.1",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
