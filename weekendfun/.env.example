# Required — one key covers browsers, sandboxes and desktops.
# Get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional — unlocks the r/<city> source, which is the best local signal there
# is. Reddit blocks ALL scraping (measured: 403 across residential, datacenter,
# stealth, captcha and bot-auth), so this uses their official API instead.
#   1. https://www.reddit.com/prefs/apps -> "create app"
#   2. type: script      redirect uri: http://localhost:8080   (never used)
#   3. client id is the string under the app name; secret is labelled "secret"
# Without these the source skips itself and everything else still runs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional — where the learning store lives.
# WEEKENDFUN_DB=./data/weekendfun.db

# Optional — set to 1 to see every query each browser runs.
# WEEKENDFUN_VERBOSE=1
